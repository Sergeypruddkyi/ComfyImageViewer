<Project>

  <!-- Production publish: dotnet publish src/ComfyImageViewer.App/ComfyImageViewer.App.csproj -c Release -p:PublishProfile=production -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <!-- Windows x64, self-contained: .NET Runtime вшит в EXE, установка runtime не нужна. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Single-file: всё приложение и runtime — один EXE. -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Нативные библиотеки тоже в бандл (WPF native DLL не разбрасываются рядом с EXE). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Сжатие бандла: меньше размер, startup чуть медленнее. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Production без PDB; ModelFamilies.json (None + CopyToOutputDirectory) остаётся внешним файлом рядом с EXE. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Вывод: <репозиторий>/publish/ (PublishProfiles -> Properties -> App -> src -> корень). -->
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\</PublishDir>
  </PropertyGroup>

  <!-- Core-проект строится со стандартным портабельным PDB, который copy-publish тянет в output;
       production-каталог должен содержать только EXE + ModelFamilies.json. -->
  <Target Name="RemovePdbsFromPublishOutput" AfterTargets="Publish">
    <ItemGroup>
      <_PublishedPdbs Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishedPdbs)" />
  </Target>

</Project>
